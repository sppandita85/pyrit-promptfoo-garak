# Copy to .env and adjust if needed:  cp .env.example .env

# Postgres (docker-compose.yml)
DB_HOST=localhost
DB_PORT=5436
DB_NAME=bankrag
DB_USER=bank
DB_PASSWORD=bank

# Ollama (runs natively on the Mac, not in Docker)
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text

# Default guardrails mode: on | off  (per-request override: header X-Guardrails)
GUARDRAILS=off

# Where the Streamlit UI and smoke test find the API
API_URL=http://localhost:8001
